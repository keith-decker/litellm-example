# LiteLLM Cisco Proxy - Environment Variables
# Copy this file to .env and set your values

# Cisco Credentials (Required for Cisco LLM)
CISCO_CLIENT_ID=your-cisco-client-id
CISCO_CLIENT_SECRET=your-cisco-client-secret
CISCO_APP_KEY=

# Database Configuration
POSTGRES_PASSWORD=litellm_password_change_in_prod

# LiteLLM Master Key (Used for admin operations)
LITELLM_MASTER_KEY=sk-master-key-change-in-prod

# Team API Keys (Automatically created on startup)
TEAM_A_KEY=sk-team-a-key-12345
TEAM_B_KEY=sk-team-b-key-67890

# Other Model API Keys
OPENAI_API_KEY=sk-9999

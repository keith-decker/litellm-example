# Environment variables for LiteLLM with Cisco integration
# Copy this to .env and fill in your actual values

# ============================================
# Cisco Credentials (REQUIRED for Cisco LLM)
# ============================================
CISCO_CLIENT_ID=your_cisco_client_id_here
CISCO_CLIENT_SECRET=your_cisco_client_secret_here
CISCO_APP_KEY=your_cisco_app_key_here  # Optional

# ============================================
# Other LLM API Keys
# ============================================
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# LiteLLM Configuration
# ============================================
LITELLM_DEBUG=true
LITELLM_PROXY_KEY=sk-1234  # Change in production!

# ============================================
# OpenTelemetry (Optional)
# ============================================
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
LITELLM_OTEL_INTEGRATION_ENABLE_EVENTS=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
